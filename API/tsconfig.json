{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "sourceMap": true,

    "types": ["node", "jest"],

    "incremental": true
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "**/*.spec.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
